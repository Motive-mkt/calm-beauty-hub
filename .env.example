# ---- Admin login (required) ----
ADMIN_PASSWORD=choose-a-long-password
# Random string used to sign the admin session cookie (openssl rand -hex 32)
SESSION_SECRET=

# ---- Client data storage ----
# Added automatically when a Vercel Blob store is connected to the project.
# Without it, the admin stores data in .data/clients.json (local development only).
BLOB_READ_WRITE_TOKEN=

# ---- Business details (shown on the site) ----
# Kenyan format, digits only with country code, e.g. 254712345678
NEXT_PUBLIC_WHATSAPP=254700000000
NEXT_PUBLIC_PHONE=254700000000
NEXT_PUBLIC_LANDMARK=
NEXT_PUBLIC_SITE_URL=

# ---- Google reviews (optional, switches the reviews section on) ----
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
